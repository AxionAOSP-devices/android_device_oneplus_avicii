# Audio
af.fast_track_multiplier=1

# eBPF
ro.bpf.kver_override=5.10.239

# GMS
ro.opa.device_model_id=ga-oplus-skill-os121-211011

# Padding for Gboard from OOS
ro.com.google.ime.kb_pad_port_l=7
ro.com.google.ime.kb_pad_port_r=7
ro.com.google.ime.kb_pad_land_l=14
ro.com.google.ime.kb_pad_land_r=14

# Padding for Baidu Keyboard from OOS
ro.com.baidu.input.pad_port_l=14
ro.com.baidu.input.pad_port_r=14
ro.com.baidu.input.pad_land_l=19
ro.com.baidu.input.pad_land_r=19
ro.com.baidu.input.pad_land_b=10

# Google Lens
ro.com.google.lens.oem_image_package=com.oneplus.gallery

# SurfaceFlinger dynamic duration
persist.sys.sf.dynamic_duration.switch=1
persist.sys.sf.dynamic_duration.sf.late.60=10500000
persist.sys.sf.dynamic_duration.app.late.60=13666666
persist.sys.sf.dynamic_duration.sf.early.60=10500000
persist.sys.sf.dynamic_duration.app.early.60=13666666
persist.sys.sf.dynamic_duration.sf.earlyGl.60=10500000
persist.sys.sf.dynamic_duration.app.earlyGl.60=13666666
persist.sys.sf.dynamic_duration.sf.late.90=9400000
persist.sys.sf.dynamic_duration.app.late.90=12400000
persist.sys.sf.dynamic_duration.sf.early.90=9400000
persist.sys.sf.dynamic_duration.app.early.90=12800000
persist.sys.sf.dynamic_duration.sf.earlyGl.90=9400000
persist.sys.sf.dynamic_duration.app.earlyGl.90=12800000
